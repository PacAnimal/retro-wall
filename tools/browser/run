#!/bin/sh
# The live wall in a browser, for development, without touching this machine's wallpaper: built and
# run in a Linux container on Xvfb (software GL) over an XFCE desktop with a few icons, shown in a
# page of our own (index.html) through noVNC: the pointer and clicks go through. From the source tree:
#
#   tools/browser/run [--size WxH] [--port PORT] [RETRO-WALL OPTION]...
#   tools/browser/run --theme forest
#
# Then open http://localhost:6080/ (or the PORT given). Ctrl-C stops it; run it again after a change.
# The build goes in a volume of its own (retro-wall-browser-target), not in target/.
set -eu
src=$(cd "$(dirname "$0")/../.." && pwd)
size=1920x1080
port=6080
while [ $# -gt 0 ]; do
	case $1 in
		--size) size=$2; shift 2 ;;
		--port) port=$2; shift 2 ;;
		*) break ;;
	esac
done

tty=; [ -t 0 ] && tty=-it
docker build -q -t retro-wall-browser "$src/tools/browser" >/dev/null
echo "browser: http://localhost:$port/"
exec docker run --rm $tty --init --name retro-wall-browser -p "127.0.0.1:$port:6080" \
	-v "$src:/src:ro" \
	-v retro-wall-browser-target:/target \
	-v retro-wall-browser-cargo:/usr/local/cargo/registry \
	-e CARGO_TARGET_DIR=/target -e RETRO_THEMES=/src/themes -e LIBGL_ALWAYS_SOFTWARE=1 \
	-w /src retro-wall-browser /src/tools/browser/serve "$size" "$@"
