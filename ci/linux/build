#!/bin/sh
# The Linux release binary, built in Ubuntu 22.04: linked against glibc 2.35, it runs there, on
# Debian 12 and on every newer system. Run from the source tree:
#
#   docker run --rm -v "$PWD:/src" -w /src ubuntu:22.04 ci/linux/build
#
# Output: target/release/retro-wall ($CARGO_TARGET_DIR/release/retro-wall if that is set).
set -eu
export DEBIAN_FRONTEND=noninteractive
apt-get update -q
apt-get install -y -q --no-install-recommends ca-certificates curl gcc libc6-dev pkg-config libcairo2-dev
curl -sSf https://sh.rustup.rs | sh -s -- -y -q --profile minimal
. "$HOME/.cargo/env"
cargo build --release --locked
