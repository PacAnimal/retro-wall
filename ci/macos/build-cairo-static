#!/bin/zsh
# Build a static cairo for macOS: pixman, libpng and cairo (Quartz surface and fonts; no FreeType,
# fontconfig, X11 or glib), so retro-wall links no library that macOS does not have. zlib, CoreText
# and the rest come from the SDK.
#
#   ci/macos/build-cairo-static PREFIX      PREFIX gets lib/*.a, include/ and lib/pkgconfig/
#
# Needs the Xcode command line tools, curl, meson, ninja and pkg-config (brew install meson ninja
# pkgconf: build tools only, nothing of them is linked). The sources are checked against their sha256.
set -eu
prefix=${1:?usage: build-cairo-static PREFIX}
mkdir -p "$prefix"; prefix=$(cd "$prefix" && pwd)
: ${MACOSX_DEPLOYMENT_TARGET:=11.0}; export MACOSX_DEPLOYMENT_TARGET
work=$prefix/.build; mkdir -p "$work"; cd "$work"

fetch() { # url sha256
  local f=${1:t}
  [[ -f $f ]] || curl -sSfL -o "$f" "$1"
  echo "$2  $f" | shasum -a 256 -c - >/dev/null || { echo "checksum mismatch: $f"; exit 1; }
  rm -rf "${f%.tar.*}"; tar xf "$f"
}
fetch https://cairographics.org/releases/pixman-0.46.4.tar.gz d09c44ebc3bd5bee7021c79f922fe8fb2fb57f7320f55e97ff9914d2346a591c
fetch https://downloads.sourceforge.net/project/libpng/libpng16/1.6.59/libpng-1.6.59.tar.xz d80dd2a38a37f803cb9b6ac7b14bd6e74ddc3b654780a8380bdf93523fdb4389
fetch https://cairographics.org/releases/cairo-1.18.6.tar.xz 1c767308174337a74694da0f3ec069c271452163a1ef4540964c50c301f157d4

# only this prefix and the SDK: never Homebrew's .pc files
export PKG_CONFIG_LIBDIR=$prefix/lib/pkgconfig PKG_CONFIG_PATH=
export CFLAGS="-O2 -mmacosx-version-min=$MACOSX_DEPLOYMENT_TARGET"

# the system's zlib, which libpng and cairo require through pkg-config; the SDK ships no .pc for it
mkdir -p "$prefix/lib/pkgconfig"
zver=$(sed -n 's/^#define ZLIB_VERSION "\(.*\)"/\1/p' "$(xcrun --show-sdk-path)/usr/include/zlib.h")
printf 'Name: zlib\nDescription: the system zlib\nVersion: %s\nLibs: -lz\nCflags:\n' "$zver" >"$prefix/lib/pkgconfig/zlib.pc"

meson setup --wipe pixman-build pixman-0.46.4 --prefix="$prefix" --libdir=lib --buildtype=release \
  -Ddefault_library=static -Dtests=disabled -Ddemos=disabled -Dgtk=disabled -Dlibpng=disabled -Dopenmp=disabled
ninja -C pixman-build install

(cd libpng-1.6.59 && ./configure -q --prefix="$prefix" --enable-static --disable-shared --disable-tests --disable-tools \
   && make -s -j8 install)

meson setup --wipe cairo-build cairo-1.18.6 --prefix="$prefix" --libdir=lib --buildtype=release \
  -Ddefault_library=static -Dquartz=enabled -Dpng=enabled -Dzlib=enabled \
  -Dfreetype=disabled -Dfontconfig=disabled -Dxlib=disabled -Dxcb=disabled -Dglib=disabled \
  -Dlzo=disabled -Dspectre=disabled -Dsymbol-lookup=disabled -Dtests=disabled -Dgtk_doc=false
ninja -C cairo-build install

rm -rf "$work"
ls "$prefix"/lib/*.a
